# --- Auth ---
# Long random string used to sign session JWTs: openssl rand -base64 48
AUTH_SECRET=
# Password required to create a new committee via POST /api/committees
ADMIN_PASS=

# --- Database ---
# Production (Vercel/Neon): a single pooled connection string.
# Injected automatically by the Vercel Neon integration.
DATABASE_URL=

# Local development (compose.yml). Used only when DATABASE_URL is unset.
DB_NAME=vehka
DB_HOST=localhost
DB_USER=postgres
DB_PASS=pass
DB_PORT=5432

# --- File storage (Vercel Blob) ---
# Injected automatically when a Blob store is attached to the Vercel project.
BLOB_READ_WRITE_TOKEN=

# --- Optional feature flags (client-side, must keep the NEXT_PUBLIC_ prefix) ---
# Set to "false" to skip uploading generated PDFs to blob storage
NEXT_PUBLIC_SAVE_PDF=
# Set to "false" to stub out the PDF download in development
NEXT_PUBLIC_PDF_DEV_DOWNLOAD=
